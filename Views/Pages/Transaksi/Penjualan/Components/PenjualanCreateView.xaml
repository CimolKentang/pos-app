<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:syncEffectsView="clr-namespace:Syncfusion.Maui.Toolkit.EffectsView;assembly=Syncfusion.Maui.Toolkit"
             xmlns:penjualanCreateVM="clr-namespace:inovasyposmobile.ViewModels.Transaksi.Penjualan"
             xmlns:produkVM="clr-namespace:inovasyposmobile.ViewModels.Masterdata.Produk"
             xmlns:masterdataModel="clr-namespace:inovasyposmobile.Models.Masterdata"
             x:Class="inovasyposmobile.Views.Pages.Transaksi.Penjualan.Components.PenjualanCreateView"
             Title="Tambah Penjualan">
        <Grid
            x:DataType="penjualanCreateVM:PenjualanCreateViewModel"
            ColumnSpacing="0"
            RowSpacing="0"
            RowDefinitions="Auto,*,Auto">
            <VerticalStackLayout
                Grid.Row="0"
                Padding="10">
                <Border
                    StrokeShape="RoundRectangle 5">
                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="5"
                        Padding="5">
                        <Label
                            Grid.Column="0"
                            VerticalOptions="Center"
                            FontFamily="MaterialSymbols"
                            FontSize="25"
                            Text="&#xE8b6;" />
                        <Entry
                            Grid.Column="1"
                            Placeholder="Cari Produk" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
            <RefreshView
                Grid.Row="1">
                <CollectionView
                    ItemsSource="{Binding Produks}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate
                            x:DataType="produkVM:PenjualanCreateProdukViewModel">
                            <HorizontalStackLayout>
                                <Grid
                                    ColumnDefinitions="Auto,*,Auto"
                                    ColumnSpacing="10"
                                    Padding="10,15">
                                    <Border 
                                        Grid.Column="0"
                                        HeightRequest="45" 
                                        WidthRequest="45"
                                        VerticalOptions="Center"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 5">
                                        <Image
                                            HeightRequest="45"
                                            WidthRequest="45">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Source" Value="no_image.png" />
                                                    <Style.Triggers>
                                                        <DataTrigger
                                                            TargetType="Image"
                                                            Binding="{Binding HasImage}"
                                                            Value="True">
                                                            <Setter Property="Source" Value="{Binding Produk.Gambar}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Border>
                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        VerticalOptions="Center">
                                        <Label
                                            FontAttributes="Bold"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding ProdukWithStok.NamaProduk}" />
                                        <Label
                                            Text="{Binding ProdukWithStok.Saldo}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
            <ActivityIndicator
                IsVisible="{Binding IsLoading}"
                Grid.Row="1"
                IsRunning="True"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="50" 
                HeightRequest="50"
                Color="{StaticResource Primary}" />
            <VerticalStackLayout
                Grid.Row="2"
                Padding="10">
                <Border
                    StrokeThickness="0"
                    HeightRequest="50"
                    BackgroundColor="{StaticResource Primary}"
                    StrokeShape="RoundRectangle 25"
                    Padding="15,5">
                    <FlexLayout
                        JustifyContent="SpaceBetween"
                        AlignItems="Center">
                        <HorizontalStackLayout
                            Spacing="5">
                            <Label
                                TextColor="White"
                                FontSize="35"
                                FontAttributes="Bold"
                                Text="{Binding Total}" />
                            <Label
                                TextColor="White"
                                VerticalOptions="End"
                                Text="Barang" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout
                            Spacing="10">
                            <Label
                                TextColor="White"
                                FontSize="16"
                                Text="Lanjut" />
                            <Label
                                FontFamily="MaterialSymbols"
                                TextColor="White"
                                FontSize="20"
                                VerticalOptions="Center"
                                Text="&#xE409;" />
                        </HorizontalStackLayout>
                    </FlexLayout>
                </Border>
            </VerticalStackLayout>
        </Grid>
</ContentPage>