                <Grid
                    ColumnDefinitions="*,*">
                    <control:DetailComponentControl
                        Grid.Column="0"
                        Title="Berat (Gram)"
                        Text="{Binding Produk.Berat}" />
                    <control:DetailComponentControl
                        Grid.Column="1"
                        Title="Lokasi"
                        Text="{Binding Produk.Lokasi}" />
                </Grid>
                <Grid
                    ColumnDefinitions="*,*">
                    <control:DetailComponentControl
                        Grid.Column="0"
                        Title="Lama penggunaan (hari)"
                        Text="{Binding Produk.LamaPenggunaan}" />
                    <control:DetailComponentControl
                        Grid.Column="1"
                        Title="Warna"
                        Text="{Binding Produk.Warna}" />
                </Grid>
                <Grid
                    ColumnDefinitions="*,*">
                    <control:DetailComponentControl
                        Grid.Column="0"
                        Title="Lebar (cm)"
                        Text="{Binding Produk.Lebar}" />
                    <control:DetailComponentControl
                        Grid.Column="1"
                        Title="Barcode"
                        Text="{Binding Produk.Barcode}" />
                </Grid>
                <Grid
                    ColumnDefinitions="*,*">
                    <control:DetailComponentControl
                        Grid.Column="0"
                        Title="SKU"
                        Text="{Binding Produk.Sku}" />
                    <control:DetailComponentControl
                        Grid.Column="1"
                        Title="Minimum Stok"
                        Text="{Binding Produk.MinStok}" />
                </Grid>
                <Grid
                    ColumnDefinitions="*,*">
                    <control:DetailComponentControl
                        Grid.Column="0"
                        Title="Ukuran"
                        Text="{Binding Produk.Ukuran}" />
                    <control:DetailComponentControl
                        Grid.Column="1"
                        Title="Panjang (cm)"
                        Text="{Binding Produk.Panjang}" />
                </Grid>
                <control:DetailComponentControl
                    Grid.Column="1"
                    Title="Tinggi (cm)"
                    Text="{Binding Produk.Tinggi}" />
            </VerticalStackLayout>
            <ActivityIndicator
                IsVisible="{Binding IsLoading}"
                Grid.Row="0"
                IsRunning="True"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="50" HeightRequest="50"
                Color="{StaticResource Primary}" />
        </Grid>
    </ScrollView>
</ContentPage>