<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModel="clr-namespace:inovasyposmobile.ViewModels.Masterdata.Produk"
             xmlns:control="clr-namespace:inovasyposmobile.Views.Controls"
             x:Class="inovasyposmobile.Views.Pages.Masterdata.Produk.Components.ProdukStokCreateView"
             Title="Stok Produk">
    <AbsoluteLayout
        x:DataType="viewModel:ProdukCreateViewModel">
        <Grid
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="SizeProportional"
            RowDefinitions="*">
            <CollectionView
                IsVisible="{Binding HasStok}"
                Grid.Row="0"
                ItemsSource="{Binding Stoks}">
                <CollectionView.ItemTemplate>
                    <DataTemplate
                        x:DataType="viewModel:ProdukStokCreateViewModel">
                        <VerticalStackLayout>
                            <VerticalStackLayout
                                Padding="10"
                                Spacing="10">
                                <Label
                                    FontAttributes="Bold"
                                    Text="{Binding NamaGudang}" />
                                <Grid
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="10">
                                    <control:EntryColumnControl
                                        Grid.Column="0"
                                        Placeholder="Stok"
                                        Keyboard="Numeric"
                                        IsRequired="True"
                                        Text="{Binding Saldo,Mode=TwoWay}" />
                                    <control:EntryColumnControl
                                        Grid.Column="1"
                                        Placeholder="Varian"
                                        IsRequired="True"
                                        Text="{Binding Varian,Mode=TwoWay}" />
                                </Grid>
                                <Grid
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="10">
                                    <control:EntryColumnControl
                                        Grid.Column="0"
                                        Placeholder="Harga Modal"
                                        Keyboard="Numeric"
                                        IsRequired="True"
                                        Text="{Binding HargaModal,Mode=TwoWay}" />
                                    <control:EntryColumnControl
                                        Grid.Column="1"
                                        Placeholder="Harga Jual"
                                        Keyboard="Numeric"
                                        IsRequired="True"
                                        Text="{Binding HargaJual,Mode=TwoWay}" />
                                </Grid>
                                <Grid
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="10"
                                    Padding="0,10,0,0">
                                    <VerticalStackLayout
                                        Grid.Column="0">
                                        <Label
                                            FontSize="12"
                                            Text="Tanggal Masuk" />
                                        <DatePicker
                                            Format="dd/MM/yyyy"
                                            Date="{Binding TanggalMasuk,Mode=TwoWay}" />
                                        <BoxView
                                            HeightRequest="1"
                                            BackgroundColor="Black" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout
                                        Grid.Column="1">
                                        <Label
                                            FontSize="12"
                                            Text="Tanggal Expired" />
                                        <DatePicker
                                            Format="dd/MM/yyyy"
                                            Date="{Binding TanggalExpired,Mode=TwoWay}" />
                                        <BoxView
                                            HeightRequest="1"
                                            BackgroundColor="Black" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                            <BoxView
                                HeightRequest="1" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Label
                IsVisible="{Binding HasNoStok}"
                Grid.Row="0"
                VerticalOptions="Center"
                HorizontalTextAlignment="Center"
                FontSize="16"
                Text="Tekan Tombol '+' dan pilih gudang untuk menambah stok" />
        </Grid>
        <Border
            AbsoluteLayout.LayoutBounds="0.5,0.95,55,55"
            AbsoluteLayout.LayoutFlags="PositionProportional"
            StrokeShape="RoundRectangle 30"
            StrokeThickness="0"
            BackgroundColor="{StaticResource Primary}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OnSelectGudangCommand}" />
            </Border.GestureRecognizers>
            <Border.Shadow>
                <Shadow
                    Offset="0,5"
                    Opacity="0.5" />
            </Border.Shadow>
            <Label
                VerticalOptions="Center"
                HorizontalOptions="Center"
                FontSize="25"
                FontFamily="MaterialSymbols"
                TextColor="White"
                Text="&#xf3dd;" />
        </Border>
    </AbsoluteLayout>
</ContentPage>