<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="SelectListOptionControlNama"
             x:Class="inovasyposmobile.Views.Controls.SelectListOptionControl">
    <VerticalStackLayout>
        <VerticalStackLayout.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Source={x:Reference SelectListOptionControlNama},Path=Command}" />
        </VerticalStackLayout.GestureRecognizers>
        <Grid
            ColumnDefinitions="*,Auto"
            ColumnSpacing="5"
            Padding="4,15">
            <Label 
                x:Name="TitleComponent"
                Grid.Column="0"
                MaxLines="1"
                VerticalOptions="Center"
                LineBreakMode="TailTruncation" />
            <Label
                Grid.Column="1"
                VerticalOptions="Center"
                FontFamily="MaterialSymbols"
                FontSize="16"
                Text="&#xE5cf;" />
        </Grid>
        <BoxView
            HeightRequest="1"
            BackgroundColor="Black" />
    </VerticalStackLayout>
</ContentView>
